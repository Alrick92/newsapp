{
  "id": "/",
  "name": "Newsfeed",
  "short_name": "Newsfeed",
  "description": "Your feeds with unread counts, stars, full-text search and AI-curated trending stories.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f8f9",
  "theme_color": "#f6f8f9",
  "categories": ["news", "productivity"],
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Latest", "short_name": "Latest", "url": "/#view=latest", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Unread", "short_name": "Unread", "url": "/#view=latest&unread=1", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Starred", "short_name": "Starred", "url": "/#view=starred", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
