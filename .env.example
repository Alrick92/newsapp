# Copy to .env and fill in. Every value is optional.

# ---- AI for trending stories ------------------------------------------------
# anthropic | openai | ollama | none. Unset: Claude if ANTHROPIC_API_KEY is set,
# otherwise keyword clustering.
NEWSFEED_AI_PROVIDER=

# Model name. Required for openai and ollama; anthropic defaults to claude-opus-5-5.
NEWSFEED_MODEL=

# anthropic
ANTHROPIC_API_KEY=

# openai: any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio, LiteLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# json_schema (default) | json_object | none; falls back automatically on a 400.
# NEWSFEED_AI_JSON_MODE=json_schema

# ollama: the bundled service (docker compose --profile ollama up -d) by default.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # Ollama on the Docker host
# Context window requested from Ollama; the prompt for 150 headlines is ~12k tokens.
# NEWSFEED_OLLAMA_NUM_CTX=32768

# Headlines sent per request (anthropic 400, others 150) and request timeout (s).
# NEWSFEED_TRENDING_MAX_ITEMS=
# NEWSFEED_AI_TIMEOUT=

# Identify your deployment to publishers (a contact URL or email).
NEWSFEED_USER_AGENT=NewsfeedAggregator/1.0 (+mailto:you@example.com)

# NEWSFEED_RETENTION_DAYS=30
# NEWSFEED_TRENDING_MINUTES=30
# NEWSFEED_OG_IMAGE_BUDGET=40

# Docker network shared with the load balancer (default: lb).
# LB_NETWORK=lb
# Addresses whose X-Forwarded-* headers are trusted (default: * on the private network).
# FORWARDED_ALLOW_IPS=*
