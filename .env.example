# Copy to .env and fill in. Every value is optional.

# ---- AI for trending stories ------------------------------------------------
# Pick ONE provider and fill in its block. Leave NEWSFEED_AI_PROVIDER empty to
# use Claude when ANTHROPIC_API_KEY is set, or keyword clustering otherwise.
#   anthropic | openai | ollama | none
NEWSFEED_AI_PROVIDER=

# Model name as the endpoint knows it. Required for openai and ollama
# (e.g. gpt-4.1-mini, meta-llama/Llama-3.1-70B-Instruct, llama3.1:8b);
# anthropic defaults to claude-opus-5-5.
NEWSFEED_MODEL=

# -- anthropic --
ANTHROPIC_API_KEY=

# -- openai: any OpenAI-compatible endpoint (OpenAI, Azure/LiteLLM gateways,
#    vLLM, LM Studio, llama.cpp server, Together, Groq, OpenRouter, ...) --
# Base URL up to and including /v1; the app calls {OPENAI_BASE_URL}/chat/completions.
OPENAI_BASE_URL=
# Sent as "Authorization: Bearer <key>". Leave empty for endpoints without auth.
OPENAI_API_KEY=
# json_schema (default) | json_object | none; falls back automatically on a 400.
# NEWSFEED_AI_JSON_MODE=json_schema

# -- ollama: a remote Ollama server --
# Server root, e.g. http://ollama.internal:11434 or https://ollama.example.com
# (a trailing /v1 is ignored; the app uses Ollama's native /api/chat).
OLLAMA_BASE_URL=
# Only if the server sits behind a proxy that checks "Authorization: Bearer <key>".
OLLAMA_API_KEY=
# Context window requested from Ollama; the prompt for 150 headlines is ~12k tokens.
# NEWSFEED_OLLAMA_NUM_CTX=32768

# Headlines sent per request (anthropic 400, others 150) and request timeout in
# seconds (openai 300, ollama 600).
# NEWSFEED_TRENDING_MAX_ITEMS=
# NEWSFEED_AI_TIMEOUT=

# Identify your deployment to publishers (a contact URL or email).
NEWSFEED_USER_AGENT=NewsfeedAggregator/1.0 (+mailto:you@example.com)

# NEWSFEED_RETENTION_DAYS=30
# At most one AI request per this many hours (schedule and Regenerate button alike).
# NEWSFEED_AI_REFRESH_HOURS=4
# Keyword-clustering cadence when no AI is configured.
# NEWSFEED_TRENDING_MINUTES=30
# NEWSFEED_OG_IMAGE_BUDGET=40

# Docker network shared with the load balancer (default: lb). Created if missing;
# set it to your proxy's existing network name to join that instead.
# LB_NETWORK=lb
# Addresses whose X-Forwarded-* headers are trusted (default: * on the private network).
# FORWARDED_ALLOW_IPS=*
